# MITOS alternate email transport example — HTTPS/Resend
# Use this profile only on infrastructure where outbound SMTP is unavailable.
# The application default remains SMTP/Nodemailer; switching back requires only
# BC_EMAIL_PROVIDER=smtp plus valid BC_SMTP_* credentials.

# General
NODE_ENV=production

# Backend server
BC_PORT=4002
BC_HTTPS=false

# MongoDB
BC_DB_URI=MONGODB_CONNECTION_STRING
BC_DB_SSL=false
BC_DB_DEBUG=false

# Auth
BC_COOKIE_SECRET=GENERATE_A_LONG_RANDOM_SECRET
BC_AUTH_COOKIE_DOMAIN=
BC_ADMIN_HOST=https://admin.example-mitos.pe/
BC_FRONTEND_HOST=https://www.example-mitos.pe/
BC_JWT_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
BC_JWT_EXPIRE_AT=86400
BC_TOKEN_EXPIRE_AT=86400

# Email — alternate HTTPS transport
BC_EMAIL_ENABLED=true
BC_EMAIL_PROVIDER=resend
BC_EMAIL_TIMEOUT_MS=10000
BC_RESEND_API_KEY=RESEND_API_KEY
BC_EMAIL_FROM="MITOS Rent a Car <no-reply@mitos.pe>"
BC_RESEND_API_URL=https://api.resend.com/emails

# SMTP/Nodemailer fallback — NOT used while BC_EMAIL_PROVIDER=resend.
# Keep these placeholders/config available so the same deployment can return to
# the canonical SMTP transport on a VPS without changing application code.
BC_SMTP_HOST=smtp.gmail.com
BC_SMTP_PORT=587
BC_SMTP_SECURE=false
BC_SMTP_USER=SMTP_USER
BC_SMTP_PASS=SMTP_PASSWORD
BC_SMTP_FROM="MITOS Rent a Car <SMTP_USER>"

# CDN (File storage)
BC_CDN_ROOT=/data/cdn
BC_CDN_USERS=/data/cdn/bookcars/users
BC_CDN_TEMP_USERS=/data/cdn/bookcars/temp/users
BC_CDN_CARS=/data/cdn/bookcars/cars
BC_CDN_TEMP_CARS=/data/cdn/bookcars/temp/cars
BC_CDN_LOCATIONS=/data/cdn/bookcars/locations
BC_CDN_TEMP_LOCATIONS=/data/cdn/bookcars/temp/locations
BC_CDN_CONTRACTS=/data/cdn/bookcars/contracts
BC_CDN_TEMP_CONTRACTS=/data/cdn/bookcars/temp/contracts
BC_CDN_LICENSES=/data/cdn/bookcars/licenses
BC_CDN_TEMP_LICENSES=/data/cdn/bookcars/temp/licenses

# Localization / product
BC_DEFAULT_LANGUAGE=es
BC_MINIMUM_AGE=21
BC_ADMIN_EMAIL=soporte@thradex.com
BC_WEBSITE_NAME=MITOS RENT A CAR
BC_TIMEZONE=America/Lima
BC_IPINFO_DEFAULT_COUNTRY=PE
BC_BATCH_SIZE=1000

# Optional providers / integrations
BC_EXPO_ACCESS_TOKEN=
BC_STRIPE_SECRET_KEY=STRIPE_SECRET_KEY
BC_STRIPE_SESSION_EXPIRE_AT=82800
BC_PAYPAL_SANDBOX=true
BC_PAYPAL_CLIENT_ID=PAYPAL_CLIENT_ID
BC_PAYPAL_CLIENT_SECRET=PAYPAL_CLIENT_SECRET
BC_MERCADO_PAGO_ACCESS_TOKEN=MERCADO_PAGO_ACCESS_TOKEN
BC_MERCADO_PAGO_PUBLIC_KEY=MERCADO_PAGO_PUBLIC_KEY
BC_RECAPTCHA_SECRET=
BC_IPINFO_API_KEY=
BC_ODOO_URL=
BC_ODOO_DB=
BC_ODOO_USERNAME=
BC_ODOO_PASSWORD=
BC_ENABLE_SENTRY=false
