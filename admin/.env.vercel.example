# MITOS ADMIN — Vercel production contract
VITE_NODE_ENV=production
VITE_BC_WEBSITE_NAME=MITOS RENT A CAR
VITE_BC_DEFAULT_LANGUAGE=es
VITE_BC_API_HOST=https://api.example-mitos.pe

# CDN currently served by the API/durable CDN authority
VITE_BC_CDN_USERS=https://api.example-mitos.pe/cdn/bookcars/users
VITE_BC_CDN_TEMP_USERS=https://api.example-mitos.pe/cdn/bookcars/temp/users
VITE_BC_CDN_CARS=https://api.example-mitos.pe/cdn/bookcars/cars
VITE_BC_CDN_TEMP_CARS=https://api.example-mitos.pe/cdn/bookcars/temp/cars
VITE_BC_CDN_LOCATIONS=https://api.example-mitos.pe/cdn/bookcars/locations
VITE_BC_CDN_TEMP_LOCATIONS=https://api.example-mitos.pe/cdn/bookcars/temp/locations
VITE_BC_CDN_CONTRACTS=https://api.example-mitos.pe/cdn/bookcars/contracts
VITE_BC_CDN_TEMP_CONTRACTS=https://api.example-mitos.pe/cdn/bookcars/temp/contracts
VITE_BC_CDN_LICENSES=https://api.example-mitos.pe/cdn/bookcars/licenses
VITE_BC_CDN_TEMP_LICENSES=https://api.example-mitos.pe/cdn/bookcars/temp/licenses

VITE_BC_PAGE_SIZE=30
VITE_BC_CARS_PAGE_SIZE=15
VITE_BC_BOOKINGS_PAGE_SIZE=20
VITE_BC_SUPPLIER_IMAGE_WIDTH=60
VITE_BC_SUPPLIER_IMAGE_HEIGHT=30
VITE_BC_CAR_IMAGE_WIDTH=300
VITE_BC_CAR_IMAGE_HEIGHT=200
VITE_BC_MINIMUM_AGE=21
VITE_BC_PAGINATION_MODE=classic
VITE_BC_CURRENCY=$
VITE_BC_CONTACT_EMAIL=soporte@thradex.com
VITE_BC_DEPOSIT_FILTER_VALUE_1=250
VITE_BC_DEPOSIT_FILTER_VALUE_2=500
VITE_BC_DEPOSIT_FILTER_VALUE_3=750

# Enable reCAPTCHA only when a production key is installed and tested.
VITE_BC_RECAPTCHA_ENABLED=false
VITE_BC_RECAPTCHA_SITE_KEY=GOOGLE_RECAPTCHA_SITE_KEY
