# syntax=docker/dockerfile:1

FROM node:lts-alpine AS build
WORKDIR /bookcars/admin

COPY ./packages /bookcars/packages
COPY ./admin ./

ARG VITE_NODE_ENV
ARG VITE_BC_WEBSITE_NAME
ARG VITE_BC_DEFAULT_LANGUAGE
ARG VITE_BC_API_HOST
ARG VITE_BC_CDN_USERS
ARG VITE_BC_CDN_TEMP_USERS
ARG VITE_BC_CDN_CARS
ARG VITE_BC_CDN_TEMP_CARS
ARG VITE_BC_CDN_LOCATIONS
ARG VITE_BC_CDN_TEMP_LOCATIONS
ARG VITE_BC_CDN_CONTRACTS
ARG VITE_BC_CDN_TEMP_CONTRACTS
ARG VITE_BC_CDN_LICENSES
ARG VITE_BC_CDN_TEMP_LICENSES
ARG VITE_BC_PAGE_SIZE
ARG VITE_BC_CARS_PAGE_SIZE
ARG VITE_BC_BOOKINGS_PAGE_SIZE
ARG VITE_BC_SUPPLIER_IMAGE_WIDTH
ARG VITE_BC_SUPPLIER_IMAGE_HEIGHT
ARG VITE_BC_CAR_IMAGE_WIDTH
ARG VITE_BC_CAR_IMAGE_HEIGHT
ARG VITE_BC_MINIMUM_AGE
ARG VITE_BC_PAGINATION_MODE
ARG VITE_BC_CURRENCY
ARG VITE_BC_CONTACT_EMAIL
ARG VITE_BC_DEPOSIT_FILTER_VALUE_1
ARG VITE_BC_DEPOSIT_FILTER_VALUE_2
ARG VITE_BC_DEPOSIT_FILTER_VALUE_3
ARG VITE_BC_RECAPTCHA_ENABLED
ARG VITE_BC_RECAPTCHA_SITE_KEY

ENV VITE_NODE_ENV=$VITE_NODE_ENV \
    VITE_BC_WEBSITE_NAME=$VITE_BC_WEBSITE_NAME \
    VITE_BC_DEFAULT_LANGUAGE=$VITE_BC_DEFAULT_LANGUAGE \
    VITE_BC_API_HOST=$VITE_BC_API_HOST \
    VITE_BC_CDN_USERS=$VITE_BC_CDN_USERS \
    VITE_BC_CDN_TEMP_USERS=$VITE_BC_CDN_TEMP_USERS \
    VITE_BC_CDN_CARS=$VITE_BC_CDN_CARS \
    VITE_BC_CDN_TEMP_CARS=$VITE_BC_CDN_TEMP_CARS \
    VITE_BC_CDN_LOCATIONS=$VITE_BC_CDN_LOCATIONS \
    VITE_BC_CDN_TEMP_LOCATIONS=$VITE_BC_CDN_TEMP_LOCATIONS \
    VITE_BC_CDN_CONTRACTS=$VITE_BC_CDN_CONTRACTS \
    VITE_BC_CDN_TEMP_CONTRACTS=$VITE_BC_CDN_TEMP_CONTRACTS \
    VITE_BC_CDN_LICENSES=$VITE_BC_CDN_LICENSES \
    VITE_BC_CDN_TEMP_LICENSES=$VITE_BC_CDN_TEMP_LICENSES \
    VITE_BC_PAGE_SIZE=$VITE_BC_PAGE_SIZE \
    VITE_BC_CARS_PAGE_SIZE=$VITE_BC_CARS_PAGE_SIZE \
    VITE_BC_BOOKINGS_PAGE_SIZE=$VITE_BC_BOOKINGS_PAGE_SIZE \
    VITE_BC_SUPPLIER_IMAGE_WIDTH=$VITE_BC_SUPPLIER_IMAGE_WIDTH \
    VITE_BC_SUPPLIER_IMAGE_HEIGHT=$VITE_BC_SUPPLIER_IMAGE_HEIGHT \
    VITE_BC_CAR_IMAGE_WIDTH=$VITE_BC_CAR_IMAGE_WIDTH \
    VITE_BC_CAR_IMAGE_HEIGHT=$VITE_BC_CAR_IMAGE_HEIGHT \
    VITE_BC_MINIMUM_AGE=$VITE_BC_MINIMUM_AGE \
    VITE_BC_PAGINATION_MODE=$VITE_BC_PAGINATION_MODE \
    VITE_BC_CURRENCY=$VITE_BC_CURRENCY \
    VITE_BC_CONTACT_EMAIL=$VITE_BC_CONTACT_EMAIL \
    VITE_BC_DEPOSIT_FILTER_VALUE_1=$VITE_BC_DEPOSIT_FILTER_VALUE_1 \
    VITE_BC_DEPOSIT_FILTER_VALUE_2=$VITE_BC_DEPOSIT_FILTER_VALUE_2 \
    VITE_BC_DEPOSIT_FILTER_VALUE_3=$VITE_BC_DEPOSIT_FILTER_VALUE_3 \
    VITE_BC_RECAPTCHA_ENABLED=$VITE_BC_RECAPTCHA_ENABLED \
    VITE_BC_RECAPTCHA_SITE_KEY=$VITE_BC_RECAPTCHA_SITE_KEY

RUN npm install --force
RUN npm run build

FROM nginx:stable-alpine
WORKDIR /usr/share/nginx/html
RUN rm -rf -- *
COPY --from=build /bookcars/admin/build ./
COPY ./admin/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 3001
CMD ["nginx", "-g", "daemon off;"]
